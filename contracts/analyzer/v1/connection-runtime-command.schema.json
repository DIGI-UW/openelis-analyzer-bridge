{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/contracts/analyzer/v1/connection-runtime-command.schema.json",
  "title": "Idempotent Bridge connection runtime command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandId",
    "connectionId",
    "action",
    "expectedConfigRevision"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "commandId": { "type": "string", "minLength": 1 },
    "connectionId": { "type": "string", "minLength": 1 },
    "action": { "enum": ["ACTIVATE", "DEACTIVATE"] },
    "expectedConfigRevision": { "type": "integer", "minimum": 1 }
  }
}
