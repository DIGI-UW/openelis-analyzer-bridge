{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/contracts/analyzer/v1/connection-probe-result.schema.json",
  "title": "Structured non-mutating Bridge connection probe result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "connectionId",
    "profileRef",
    "configRevision",
    "configFingerprint",
    "nonMutating",
    "status",
    "startedAt",
    "completedAt",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "connectionId": { "type": "string", "minLength": 1 },
    "profileRef": { "$ref": "#/$defs/profileRef" },
    "configRevision": { "type": "integer", "minimum": 1 },
    "configFingerprint": { "$ref": "#/$defs/fingerprint" },
    "nonMutating": { "const": true },
    "status": { "enum": ["SUCCEEDED", "FAILED", "TIMEOUT", "BLOCKED"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "revision", "fingerprint"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "fingerprint": { "$ref": "#/$defs/fingerprint" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "status", "messageKey", "durationMillis"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASSED", "FAILED", "SKIPPED"] },
        "messageKey": { "type": "string", "minLength": 1 },
        "durationMillis": { "type": "integer", "minimum": 0 },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    }
  }
}
