{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/contracts/analyzer/v1/profile-catalog-entry.schema.json",
  "title": "OpenELIS Analyzer Bridge profile catalog entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "audit", "fingerprint"],
  "properties": {
    "profile": {
      "type": "object"
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "actor", "markedAt"],
      "properties": {
        "action": {
          "enum": [
            "SHIPPED",
            "CREATED",
            "FORKED",
            "UPDATED",
            "DEACTIVATED",
            "REACTIVATED"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "markedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
