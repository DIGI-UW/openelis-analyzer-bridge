{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/contracts/analyzer/v1/profile-catalog-response.schema.json",
  "title": "OpenELIS Analyzer Bridge profile catalog response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogFingerprint", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "catalogFingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "https://openelis-global.org/contracts/analyzer/v1/profile-catalog-entry.schema.json"
      }
    },
    "issues": {
      "type": "array",
      "description": "Profile files and drafts the Bridge set aside when it loaded, and why. Every other profile is served.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reason"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
