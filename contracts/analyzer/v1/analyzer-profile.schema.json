{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/contracts/analyzer/v1/analyzer-profile.schema.json",
  "title": "OpenELIS Analyzer Bridge profile revision v1",
  "description": "Strict evolution of the established analyzer-defaults profile. The profile defines analyzer runtime communication and defaults for a new Bridge connection; catalog metadata is generated separately under catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "profileMeta",
    "category",
    "protocol",
    "capabilities",
    "configDefaults",
    "connectionFields",
    "controlResultRecognition",
    "catalog"
  ],
  "properties": {
    "$schema": {
      "const": "https://openelis-global.org/contracts/analyzer/v1/analyzer-profile.schema.json"
    },
    "schemaVersion": { "const": "1.0" },
    "profileMeta": { "$ref": "#/$defs/profileMeta" },
    "analyzer_name": { "$ref": "#/$defs/nonBlank" },
    "manufacturer": { "$ref": "#/$defs/nonBlank" },
    "model": { "$ref": "#/$defs/nonBlank" },
    "category": {
      "enum": [
        "HEMATOLOGY",
        "CHEMISTRY",
        "IMMUNOLOGY",
        "MICROBIOLOGY",
        "MOLECULAR",
        "COAGULATION"
      ]
    },
    "protocol": {
      "oneOf": [
        { "$ref": "#/$defs/astmProtocol" },
        { "$ref": "#/$defs/hl7Protocol" },
        { "$ref": "#/$defs/fileProtocol" }
      ]
    },
    "identifier_pattern": { "$ref": "#/$defs/nonBlank" },
    "msh3_pattern": { "$ref": "#/$defs/nonBlank" },
    "transport": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["RS-232", "TCP/IP", "MLLP", "HTTP"] }
    },
    "transport_config": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "RS-232": { "$ref": "#/$defs/serialTransportSettings" },
        "TCP/IP": { "$ref": "#/$defs/transportSettings" },
        "MLLP": { "$ref": "#/$defs/transportSettings" },
        "HTTP": { "$ref": "#/$defs/transportSettings" }
      }
    },
    "communication": { "$ref": "#/$defs/communication" },
    "capabilities": { "$ref": "#/$defs/capabilities" },
    "supported_extensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
    },
    "column_mapping": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/nonBlank" },
      "additionalProperties": {
        "enum": [
          "sampleId",
          "testCode",
          "result",
          "units",
          "interpretation",
          "qcTask",
          "testDate",
          "ctValue",
          "position"
        ]
      }
    },
    "result_value_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["result", "ctValue", "interpretation"] }
    },
    "sheet_detection": { "$ref": "#/$defs/sheetDetection" },
    "default_test_mappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/testMapping" }
    },
    "configDefaults": { "type": "object" },
    "connectionFields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/connectionField" }
    },
    "controlResultRecognition": { "$ref": "#/$defs/controlResultRecognition" },
    "catalog": { "$ref": "#/$defs/catalogMetadata" },
    "authoring": { "$ref": "#/$defs/authoring" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol": {
            "properties": { "name": { "const": "ASTM" } },
            "required": ["name"]
          }
        },
        "required": ["protocol"]
      },
      "then": {
        "required": [
          "analyzer_name",
          "manufacturer",
          "identifier_pattern",
          "transport",
          "transport_config",
          "communication",
          "default_test_mappings"
        ],
        "properties": {
          "default_test_mappings": {
            "type": "array",
            "items": { "$ref": "#/$defs/testMapping" }
          },
          "configDefaults": { "$ref": "#/$defs/astmSocketDefaults" },
          "controlResultRecognition": {
            "$ref": "#/$defs/astmControlResultRecognition"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocol": {
            "properties": { "name": { "const": "HL7" } },
            "required": ["name"]
          }
        },
        "required": ["protocol"]
      },
      "then": {
        "required": [
          "analyzer_name",
          "manufacturer",
          "identifier_pattern",
          "transport",
          "transport_config",
          "communication",
          "default_test_mappings"
        ],
        "properties": {
          "default_test_mappings": {
            "type": "array",
            "items": { "$ref": "#/$defs/testMapping" }
          },
          "configDefaults": { "$ref": "#/$defs/socketDefaults" },
          "controlResultRecognition": {
            "$ref": "#/$defs/hl7ControlResultRecognition"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocol": {
            "properties": { "name": { "const": "FILE" } },
            "required": ["name"]
          }
        },
        "required": ["protocol"]
      },
      "then": {
        "required": ["supported_extensions", "column_mapping"],
        "properties": {
          "configDefaults": { "$ref": "#/$defs/fileDefaults" },
          "controlResultRecognition": {
            "$ref": "#/$defs/fileControlResultRecognition"
          }
        }
      }
    }
  ],
  "$defs": {
    "nonBlank": { "type": "string", "pattern": ".*\\S.*" },
    "jsonValue": {
      "type": ["string", "number", "boolean", "array", "object", "null"]
    },
    "connectionChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "labelKey"],
      "properties": {
        "value": { "$ref": "#/$defs/jsonValue" },
        "labelKey": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "connectionCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldKey", "operator", "value"],
      "properties": {
        "fieldKey": { "$ref": "#/$defs/nonBlank" },
        "operator": { "enum": ["EQUALS", "NOT_EQUALS", "IN", "NOT_IN"] },
        "value": { "$ref": "#/$defs/jsonValue" }
      }
    },
    "connectionField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "labelKey", "inputKind", "required", "choices"],
      "properties": {
        "key": { "$ref": "#/$defs/nonBlank" },
        "labelKey": { "$ref": "#/$defs/nonBlank" },
        "helpTextKey": { "$ref": "#/$defs/nonBlank" },
        "inputKind": {
          "enum": ["TEXT", "NUMBER", "SELECT", "BOOLEAN", "SECRET", "FILE_PATH"]
        },
        "required": { "type": "boolean" },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/connectionChoice" }
        },
        "visibleWhen": { "$ref": "#/$defs/connectionCondition" }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "version": { "$ref": "#/$defs/nonBlank" },
        "displayName": { "$ref": "#/$defs/nonBlank" },
        "manufacturer": { "$ref": "#/$defs/nonBlank" },
        "confidence": {
          "enum": [
            "VALIDATED",
            "HIGH",
            "MEDIUM_HIGH",
            "MEDIUM",
            "ESTIMATED",
            "LOW",
            "NA"
          ]
        }
      }
    },
    "astmProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "lowerLayerVersion"],
      "properties": {
        "name": { "const": "ASTM" },
        "version": { "$ref": "#/$defs/nonBlank" },
        "lowerLayerVersion": { "enum": ["LIS01_A", "E1381_95"] }
      }
    },
    "hl7Protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "HL7" },
        "version": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "fileProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "format"],
      "properties": {
        "name": { "const": "FILE" },
        "format": { "enum": ["CSV", "TSV", "XLS", "XLSX", "ODS", "XML"] }
      }
    },
    "transportSettings": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "integer", "boolean"]
      }
    },
    "serialTransportSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_baud_rate",
        "data_bits",
        "stop_bits",
        "parity",
        "flow_control",
        "read_timeout_ms",
        "message_timeout_ms",
        "reconnect_interval_ms",
        "max_reconnect_attempts",
        "rts_enabled",
        "dtr_enabled"
      ],
      "properties": {
        "default_baud_rate": { "type": "integer", "minimum": 1 },
        "data_bits": { "type": "integer", "minimum": 5, "maximum": 8 },
        "stop_bits": { "enum": [1, 2, 3] },
        "parity": { "enum": ["NONE", "ODD", "EVEN", "MARK", "SPACE"] },
        "flow_control": { "enum": ["NONE", "RTS_CTS", "XON_XOFF"] },
        "read_timeout_ms": { "type": "integer", "minimum": 1 },
        "message_timeout_ms": { "type": "integer", "minimum": 1 },
        "reconnect_interval_ms": { "type": "integer", "minimum": 1 },
        "max_reconnect_attempts": { "type": "integer", "minimum": -1 },
        "rts_enabled": { "type": "boolean" },
        "dtr_enabled": { "type": "boolean" }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "supports_lis_initiated"],
      "properties": {
        "mode": {
          "enum": ["ANALYZER_INITIATED", "LIS_INITIATED", "BOTH"]
        },
        "supports_lis_initiated": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inboundResults", "outboundOrders", "connectionTest"],
      "properties": {
        "inboundResults": { "const": true },
        "outboundOrders": { "type": "boolean" },
        "connectionTest": { "type": "boolean" }
      }
    },
    "coding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "code"],
      "properties": {
        "system": { "type": "string", "format": "uri" },
        "code": { "$ref": "#/$defs/nonBlank" },
        "display": { "$ref": "#/$defs/nonBlank" }
      }
    },
    "testMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_code", "loinc"],
      "properties": {
        "test_code": { "$ref": "#/$defs/nonBlank" },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "test_name_hint": { "$ref": "#/$defs/nonBlank" },
        "loinc": { "type": "string", "pattern": "^[0-9]{1,8}-[0-9]$" },
        "unit": { "type": "string" },
        "result_type": {
          "enum": ["quantitative", "qualitative", "text"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "normalized_coding": { "$ref": "#/$defs/coding" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "result_type": { "const": "qualitative" } },
            "required": ["result_type"]
          },
          "then": { "required": ["values"] }
        },
        {
          "if": { "required": ["values"] },
          "then": {
            "properties": { "result_type": { "const": "qualitative" } },
            "required": ["result_type"]
          }
        }
      ]
    },
    "socketDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionRole", "aggregationMode"],
      "properties": {
        "dataFlow": { "enum": ["RESULTS_ONLY", "TWO_WAY"] },
        "connectionRole": { "enum": ["SERVER", "CLIENT"] },
        "transport": { "enum": ["RS-232", "TCP/IP", "MLLP", "HTTP"] },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "aggregationMode": { "enum": ["PER_MESSAGE", "BY_SPECIMEN"] },
        "aggregationWindowSeconds": { "type": "integer", "minimum": 0 },
        "extractionOverrides": { "type": "object" },
        "flagMappings": { "type": "object" },
        "transforms": { "type": "object" }
      }
    },
    "astmSocketDefaults": {
      "allOf": [
        { "$ref": "#/$defs/socketDefaults" },
        {
          "required": ["extractionOverrides"],
          "properties": {
            "extractionOverrides": {
              "$ref": "#/$defs/astmExtractionOverrides"
            }
          }
        }
      ]
    },
    "astmExtractionOverrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultRecordSelection"],
      "properties": {
        "resultRecordSelection": {
          "$ref": "#/$defs/astmResultRecordSelection"
        }
      }
    },
    "astmResultRecordSelection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "ALL" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "targetField"],
          "properties": {
            "mode": { "const": "FIELD_NON_BLANK" },
            "targetField": {
              "type": "string",
              "pattern": "^R\\.[1-9][0-9]*\\.[1-9][0-9]*$"
            }
          }
        }
      ]
    },
    "fileDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileFormat", "filePattern"],
      "properties": {
        "dataFlow": { "const": "RESULTS_ONLY" },
        "fileFormat": { "enum": ["CSV", "TSV", "XLS", "XLSX", "ODS", "XML"] },
        "filePattern": {
          "allOf": [{ "$ref": "#/$defs/nonBlank" }],
          "description": "Java NIO filename glob evaluated by the Bridge FILE watcher, for example *.{ods,xlsx,xls}."
        },
        "hasHeader": { "type": "boolean" },
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
        "encoding": { "$ref": "#/$defs/nonBlank" },
        "sheetIndex": { "type": "integer", "minimum": 0 },
        "skipRows": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "fileFormat": {
                "enum": ["CSV", "TSV", "XLS", "XLSX", "ODS"]
              }
            },
            "required": ["fileFormat"]
          },
          "then": { "required": ["hasHeader"] }
        }
      ]
    },
    "sheetDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "preferred_sheet_names",
        "header_marker",
        "max_sheets_to_scan",
        "max_rows_to_scan"
      ],
      "properties": {
        "strategy": { "const": "header_scan" },
        "preferred_sheet_names": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonBlank" }
        },
        "header_marker": { "$ref": "#/$defs/nonBlank" },
        "max_sheets_to_scan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_rows_to_scan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "controlResultRecognition": {
      "oneOf": [
        { "$ref": "#/$defs/rulesRecognition" },
        { "$ref": "#/$defs/noneRecognition" }
      ]
    },
    "rulesRecognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rules"],
      "properties": {
        "mode": { "const": "RULES" },
        "rules": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "additionalProperties": { "$ref": "#/$defs/controlRecognitionRule" }
        }
      }
    },
    "noneRecognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "affirmedNoControlResults"],
      "properties": {
        "mode": { "const": "NONE" },
        "affirmedNoControlResults": { "const": true }
      }
    },
    "controlRecognitionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleType", "operand"],
      "properties": {
        "ruleType": {
          "enum": [
            "SPECIMEN_ID_PREFIX",
            "SPECIMEN_ID_PATTERN",
            "FIELD_EQUALS",
            "FIELD_CONTAINS"
          ]
        },
        "targetField": { "$ref": "#/$defs/nonBlank" },
        "operand": { "$ref": "#/$defs/nonBlank" },
        "controlLevel": { "$ref": "#/$defs/nonBlank" },
        "controlType": { "$ref": "#/$defs/nonBlank" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ruleType": { "enum": ["FIELD_EQUALS", "FIELD_CONTAINS"] }
            },
            "required": ["ruleType"]
          },
          "then": { "required": ["targetField"] }
        },
        {
          "if": {
            "properties": {
              "ruleType": {
                "enum": ["SPECIMEN_ID_PREFIX", "SPECIMEN_ID_PATTERN"]
              }
            },
            "required": ["ruleType"]
          },
          "then": { "not": { "required": ["targetField"] } }
        }
      ]
    },
    "astmControlResultRecognition": {
      "$ref": "#/$defs/controlResultRecognition",
      "properties": {
        "rules": {
          "additionalProperties": {
            "allOf": [
              { "$ref": "#/$defs/controlRecognitionRule" },
              {
                "if": {
                  "properties": {
                    "ruleType": { "enum": ["FIELD_EQUALS", "FIELD_CONTAINS"] }
                  },
                  "required": ["ruleType"]
                },
                "then": {
                  "properties": {
                    "targetField": {
                      "pattern": "^[A-Z][0-9]?\\.[1-9][0-9]*(?:\\.[1-9][0-9]*){0,2}$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "hl7ControlResultRecognition": {
      "$ref": "#/$defs/controlResultRecognition",
      "properties": {
        "rules": {
          "additionalProperties": {
            "allOf": [
              { "$ref": "#/$defs/controlRecognitionRule" },
              {
                "if": {
                  "properties": {
                    "ruleType": { "enum": ["FIELD_EQUALS", "FIELD_CONTAINS"] }
                  },
                  "required": ["ruleType"]
                },
                "then": {
                  "properties": {
                    "targetField": {
                      "pattern": "^[A-Z0-9]{3}\\.[1-9][0-9]*(?:\\.[1-9][0-9]*){0,2}$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "fileControlResultRecognition": {
      "$ref": "#/$defs/controlResultRecognition",
      "properties": {
        "rules": {
          "additionalProperties": {
            "allOf": [
              { "$ref": "#/$defs/controlRecognitionRule" },
              {
                "if": {
                  "properties": {
                    "ruleType": { "enum": ["FIELD_EQUALS", "FIELD_CONTAINS"] }
                  },
                  "required": ["ruleType"]
                },
                "then": {
                  "properties": {
                    "targetField": {
                      "enum": [
                        "SAMPLE_ID",
                        "TEST_CODE",
                        "RESULT",
                        "INTERPRETATION",
                        "QC_TASK",
                        "UNITS",
                        "TEST_DATE",
                        "CT_VALUE"
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "catalogMetadata": {
      "type": "object",
      "readOnly": true,
      "additionalProperties": false,
      "required": [
        "revision",
        "revisionFingerprint",
        "recognitionFingerprint",
        "source",
        "status",
        "publishedAt",
        "publishedBy"
      ],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "revisionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "recognitionFingerprint": { "$ref": "#/$defs/fingerprint" },
        "source": { "enum": ["SHIPPED", "SITE"] },
        "status": { "enum": ["ACTIVE", "INACTIVE"] },
        "publishedAt": { "type": "string", "format": "date-time" },
        "publishedBy": { "$ref": "#/$defs/nonBlank" },
        "lineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["parentProfileId", "parentRevision"],
          "properties": {
            "parentProfileId": { "$ref": "#/$defs/nonBlank" },
            "parentRevision": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": { "$ref": "#/$defs/nonBlank" },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
