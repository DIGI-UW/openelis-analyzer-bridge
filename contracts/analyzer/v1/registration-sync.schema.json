{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/contracts/analyzer/v1/registration-sync.schema.json",
  "title": "OpenELIS desired analyzer registration sync v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "desiredStateRevision",
    "generatedAt",
    "analyzers"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "desiredStateRevision": { "type": "string", "minLength": 8 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "analyzers": {
      "type": "array",
      "items": { "$ref": "#/$defs/analyzerRegistration" }
    }
  },
  "$defs": {
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "revision"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "role", "settings"],
      "properties": {
        "mode": { "enum": ["TCP", "MLLP", "SERIAL", "FILE", "HTTP"] },
        "role": { "enum": ["RECEIVER", "INITIATOR"] },
        "settings": {
          "type": "object",
          "propertyNames": {
            "not": {
              "pattern": "(?i)(qc|quality.?control|control.?lot|westgard|classifier|recognition|rule|assigned.?mean|standard.?deviation|release.?policy|hold.?policy)"
            }
          },
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      }
    },
    "analyzerRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oeAnalyzerId",
        "sourceId",
        "name",
        "profileRef",
        "protocol",
        "desiredStatus",
        "desiredStateFingerprint",
        "connection"
      ],
      "properties": {
        "oeAnalyzerId": { "type": "string", "minLength": 1 },
        "sourceId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "profileRef": { "$ref": "#/$defs/profileRef" },
        "protocol": { "enum": ["ASTM", "HL7", "FILE"] },
        "desiredStatus": { "enum": ["INACTIVE", "ACTIVE"] },
        "desiredStateFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "connection": { "$ref": "#/$defs/connection" }
      }
    }
  }
}
