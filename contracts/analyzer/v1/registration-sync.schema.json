{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openelis-global.org/contracts/analyzer/v1/registration-sync.schema.json",
  "title": "OpenELIS desired analyzer registration sync v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "desiredStateRevision",
    "generatedAt",
    "analyzers"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "desiredStateRevision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "analyzers": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/analyzerRegistration" }
    }
  },
  "$defs": {
    "profileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "revision"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "tcpSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bindAddress": { "type": "string", "minLength": 1 },
        "listenPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "remoteHost": { "type": "string", "minLength": 1 },
        "remotePort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "connectTimeoutMillis": { "type": "integer", "minimum": 1 },
        "tls": { "type": "boolean" }
      }
    },
    "serialSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device"],
      "properties": {
        "device": { "type": "string", "minLength": 1 },
        "baudRate": { "type": "integer", "minimum": 1 },
        "dataBits": { "enum": [5, 6, 7, 8] },
        "stopBits": { "enum": [1, 1.5, 2] },
        "parity": { "enum": ["NONE", "EVEN", "ODD", "MARK", "SPACE"] },
        "flowControl": { "enum": ["NONE", "HARDWARE", "SOFTWARE"] }
      }
    },
    "fileSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory"],
      "properties": {
        "directory": { "type": "string", "minLength": 1 }
      }
    },
    "httpSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "connectTimeoutMillis": { "type": "integer", "minimum": 1 },
        "tls": { "type": "boolean" }
      }
    },
    "tcpConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "role", "settings"],
      "properties": {
        "mode": { "const": "TCP" },
        "role": { "enum": ["RECEIVER", "INITIATOR"] },
        "settings": { "$ref": "#/$defs/tcpSettings" }
      }
    },
    "mllpConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "role", "settings"],
      "properties": {
        "mode": { "const": "MLLP" },
        "role": { "enum": ["RECEIVER", "INITIATOR"] },
        "settings": { "$ref": "#/$defs/tcpSettings" }
      }
    },
    "serialConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "role", "settings"],
      "properties": {
        "mode": { "const": "SERIAL" },
        "role": { "enum": ["RECEIVER", "INITIATOR"] },
        "settings": { "$ref": "#/$defs/serialSettings" }
      }
    },
    "fileConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "role", "settings"],
      "properties": {
        "mode": { "const": "FILE" },
        "role": { "const": "RECEIVER" },
        "settings": { "$ref": "#/$defs/fileSettings" }
      }
    },
    "httpConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "role", "settings"],
      "properties": {
        "mode": { "const": "HTTP" },
        "role": { "enum": ["RECEIVER", "INITIATOR"] },
        "settings": { "$ref": "#/$defs/httpSettings" }
      }
    },
    "connection": {
      "oneOf": [
        { "$ref": "#/$defs/tcpConnection" },
        { "$ref": "#/$defs/mllpConnection" },
        { "$ref": "#/$defs/serialConnection" },
        { "$ref": "#/$defs/fileConnection" },
        { "$ref": "#/$defs/httpConnection" }
      ]
    },
    "analyzerRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "name",
        "profileRef",
        "protocol",
        "desiredStatus",
        "desiredStateFingerprint",
        "connection"
      ],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "profileRef": { "$ref": "#/$defs/profileRef" },
        "protocol": { "enum": ["ASTM", "HL7", "FILE"] },
        "desiredStatus": { "enum": ["INACTIVE", "ACTIVE"] },
        "desiredStateFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "connection": { "$ref": "#/$defs/connection" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "protocol": { "const": "ASTM" } },
            "required": ["protocol"]
          },
          "then": {
            "properties": {
              "connection": {
                "oneOf": [
                  { "$ref": "#/$defs/tcpConnection" },
                  { "$ref": "#/$defs/serialConnection" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "protocol": { "const": "HL7" } },
            "required": ["protocol"]
          },
          "then": {
            "properties": {
              "connection": {
                "oneOf": [
                  { "$ref": "#/$defs/tcpConnection" },
                  { "$ref": "#/$defs/mllpConnection" },
                  { "$ref": "#/$defs/httpConnection" }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "protocol": { "const": "FILE" } },
            "required": ["protocol"]
          },
          "then": {
            "properties": {
              "connection": { "$ref": "#/$defs/fileConnection" }
            }
          }
        }
      ]
    }
  }
}
