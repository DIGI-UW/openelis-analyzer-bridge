{
  "$schema": "https://openelis-global.org/contracts/analyzer/v1/analyzer-profile.schema.json",
  "schemaVersion": "2.0",
  "profileMeta": {
    "id": "site.template-astm",
    "version": "1.0.0",
    "displayName": "Template ASTM instrument",
    "confidence": "LOW"
  },
  "analyzer_name": "Template ASTM instrument",
  "manufacturer": "Manufacturer",
  "category": "MOLECULAR",
  "protocol": {
    "name": "ASTM",
    "version": "E-1394-97",
    "lowerLayerVersion": "LIS01_A"
  },
  "identifier_pattern": "SENDER-NAME|MODEL",
  "transport": ["RS-232", "TCP/IP"],
  "transport_config": {
    "RS-232": {
      "default_baud_rate": 9600,
      "data_bits": 8,
      "stop_bits": 1,
      "parity": "NONE",
      "flow_control": "NONE",
      "read_timeout_ms": 1000,
      "message_timeout_ms": 30000,
      "reconnect_interval_ms": 5000,
      "max_reconnect_attempts": -1,
      "rts_enabled": true,
      "dtr_enabled": true
    },
    "TCP/IP": {}
  },
  "communication": {
    "mode": "BOTH",
    "supports_lis_initiated": true
  },
  "capabilities": {
    "inboundResults": true,
    "outboundOrders": true,
    "connectionTest": true
  },
  "default_test_mappings": [
    {
      "test_code": "TEST-CODE",
      "loinc": "0000-0",
      "unit": "units",
      "result_type": "quantitative",
      "test_name_hint": "Name of the test as the instrument shows it",
      "values": ["VALUE-ONE", "VALUE-TWO"],
      "value_codes": {
        "VALUE-ONE": [
          {
            "system": "http://loinc.org",
            "code": "LA00000-0"
          }
        ],
        "VALUE-TWO": [
          {
            "system": "http://snomed.info/sct",
            "code": "000000000"
          }
        ]
      },
      "translations": {
        "VALUE-ONE": ["The same value in another language"]
      },
      "call_component": "call",
      "run_failure_values": ["ERROR", "NO RESULT"],
      "components": [
        {
          "code": "call",
          "label": "Call",
          "result_type": "qualitative"
        },
        {
          "code": "ANALYTE Ct",
          "label": "Analyte Ct",
          "result_type": "quantitative",
          "sub_identity": "ANALYTE&Ct"
        }
      ],
      "assay": {
        "name": "Assay name as the instrument reports it",
        "version": "1"
      },
      "source": {
        "document": "Vendor document title and revision",
        "section": "Section that defines this test"
      }
    }
  ],
  "configDefaults": {
    "dataFlow": "RESULTS_ONLY",
    "connectionRole": "SERVER",
    "transport": "TCP/IP",
    "aggregationMode": "PER_MESSAGE",
    "extractionOverrides": {
      "resultRecordSelection": {
        "mode": "ALL"
      },
      "resultParts": {
        "testCode": "R.3.4",
        "assayName": "R.3.5",
        "assayVersion": "R.3.6",
        "analyte": "R.3.7",
        "complement": "R.3.8",
        "call": "R.4.1",
        "number": "R.4.2",
        "unit": "R.5",
        "range": "R.6",
        "flag": "R.7",
        "status": "R.9",
        "operator": "R.11",
        "started": "R.12",
        "completed": "R.13",
        "instrument": "R.14",
        "note": "C.4",
        "patientId": "P.5",
        "patientName": "P.6",
        "specimenDescriptor": "O.16"
      }
    },
    "flagMappings": {},
    "transforms": {},
    "numberFormat": "."
  },
  "connectionFields": [
    {
      "key": "dataFlow",
      "labelKey": "analyzer.setup.connect.dataFlow",
      "inputKind": "SELECT",
      "required": true,
      "choices": [
        {
          "value": "RESULTS_ONLY",
          "labelKey": "analyzer.setup.connect.dataFlow.resultsOnly"
        },
        {
          "value": "TWO_WAY",
          "labelKey": "analyzer.setup.connect.dataFlow.twoWay"
        }
      ]
    },
    {
      "key": "transport",
      "labelKey": "analyzer.connection.field.transport",
      "inputKind": "SELECT",
      "required": true,
      "choices": [
        {
          "value": "RS-232",
          "labelKey": "analyzer.connection.transport.RS-232"
        },
        {
          "value": "TCP/IP",
          "labelKey": "analyzer.connection.transport.TCP/IP"
        }
      ]
    },
    {
      "key": "connectionRole",
      "labelKey": "analyzer.connection.field.connectionRole",
      "inputKind": "SELECT",
      "required": true,
      "choices": [
        {
          "value": "SERVER",
          "labelKey": "analyzer.connection.role.server"
        },
        {
          "value": "CLIENT",
          "labelKey": "analyzer.connection.role.client"
        }
      ],
      "visibleWhen": {
        "fieldKey": "transport",
        "operator": "NOT_EQUALS",
        "value": "RS-232"
      }
    },
    {
      "key": "host",
      "labelKey": "analyzer.connection.field.host",
      "helpTextKey": "analyzer.connection.field.host.help",
      "inputKind": "TEXT",
      "required": false,
      "choices": [],
      "visibleWhen": {
        "fieldKey": "transport",
        "operator": "EQUALS",
        "value": "TCP/IP"
      }
    },
    {
      "key": "senderId",
      "labelKey": "analyzer.connection.field.senderId",
      "helpTextKey": "analyzer.connection.field.senderId.help",
      "inputKind": "TEXT",
      "required": false,
      "choices": [],
      "visibleWhen": {
        "fieldKey": "transport",
        "operator": "EQUALS",
        "value": "TCP/IP"
      }
    },
    {
      "key": "port",
      "labelKey": "analyzer.connection.field.port",
      "inputKind": "NUMBER",
      "required": true,
      "choices": [],
      "visibleWhen": {
        "fieldKey": "transport",
        "operator": "EQUALS",
        "value": "TCP/IP"
      }
    },
    {
      "key": "serialPort",
      "labelKey": "analyzer.connection.field.serialPort",
      "inputKind": "TEXT",
      "required": true,
      "choices": [],
      "visibleWhen": {
        "fieldKey": "transport",
        "operator": "EQUALS",
        "value": "RS-232"
      }
    },
    {
      "key": "numberFormat",
      "labelKey": "analyzer.connection.field.numberFormat",
      "inputKind": "SELECT",
      "required": false,
      "choices": [
        {
          "value": ".",
          "labelKey": "analyzer.connection.numberFormat.point"
        },
        {
          "value": ",",
          "labelKey": "analyzer.connection.numberFormat.comma"
        }
      ]
    }
  ],
  "controlResultRecognition": {
    "mode": "RULES",
    "rules": {
      "astm-order-action-control": {
        "ruleType": "FIELD_EQUALS",
        "targetField": "O.12",
        "operand": "Q"
      }
    }
  }
}
